+// Preserve lazy-task ownership while keeping per-request refcount writes local
+// to the executing reactor. The local control block pins the original owner once.
+// Tasks may still outlive the context or be transferred; shared_ptr remains atomic.
+template<class T>
+std::shared_ptr<T> reactor_owner(const std::shared_ptr<T>& owner) {
+    auto* io = io_context::current();
+    if (!io) return owner;
+    auto* local = static_cast<std::shared_ptr<T>*>(io->find_local_state(owner.get()));
+    if (!local) local = static_cast<std::shared_ptr<T>*>(io->local_state(owner, [&] {
+        return std::make_shared<std::shared_ptr<T>>(owner.get(), [keep = owner](T*) {});
+    }).get());
+    return *local;
+}
