+struct frame_cache
+{
+    struct node { node* next; };
+    node* lists[6]{};
+    std::size_t retained = 0;
+    ~frame_cache()
+    {
+        for (auto head : lists) while (head) { auto* next = head->next; ::operator delete(head); head = next; }
+    }
+};
+thread_local frame_cache* active_cache;
+unsigned frame_class(std::size_t size) { return size <= 128 ? 0u : std::bit_width((size-1) >> 7); }
+}
+void* promise_base::operator new(std::size_t size)
+{
+    if (size > 4096) return ::operator new(size);
+    const auto i = frame_class(size);
+    const std::size_t bytes = std::size_t{128} << i;
+    if (active_cache && active_cache->lists[i])
+    {
+        auto* head = active_cache->lists[i]; active_cache->lists[i] = head->next;
+        active_cache->retained -= bytes; return head;
+    }
+    return ::operator new(bytes);
+}
+void promise_base::operator delete(void* p, std::size_t size) noexcept
+{
+    if (active_cache && size <= 4096)
+    {
+        const auto i = frame_class(size);
+        const std::size_t bytes = std::size_t{128} << i;
+        if (active_cache->retained + bytes <= 128*1024)
+        {
+            active_cache->lists[i] = ::new(p) frame_cache::node{active_cache->lists[i]};
+            active_cache->retained += bytes; return;
+        }
+    }
+    ::operator delete(p);
+}
